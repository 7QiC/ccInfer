BasedOnStyle: Google
ColumnLimit: 100
IndentWidth: 4
UseTab: Never
IndentCaseLabels: true
AccessModifierOffset: -4
MaxEmptyLinesToKeep: 1
IncludeBlocks: Regroup
IncludeIsMainRegex: '(Test)?$'
IncludeCategories:
  - Regex: '^<(cuda|gtest|boost|nlohmann|fmt|spdlog).*>'
    Priority: 4
    SortPriority: 2
  - Regex: '^<.*>'
    Priority: 3
    SortPriority: 1
  - Regex: '^".*"'
    Priority: 5
    SortPriority: 3
SortIncludes: true
